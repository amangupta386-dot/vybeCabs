{
  "name": "driver-matching-system",
  "version": "1.0.0",
  "description": "Node.js + Express driver matching API using PostgreSQL and Redis GEO/concurrency primitives.",
  "private": true,
  "scripts": {
    "start": "node src/main.js",
    "start:dev": "node src/main.js",
    "build": "node -c src/main.js",
    "lint": "eslint \"src/**/*.js\" \"public/**/*.js\"",
    "test": "jest",
    "db:sync": "node src/database/migrate.js"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.js$",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "testEnvironment": "node"
  }
}
